{
  "swagger": "2.0",
  "info": {
    "title": "Azure Function - HTTP Endpoints",
    "description": "Custom connector for the private Flex Consumption Function App, routed through the PowerPlatformAzureVnetBootCampDev-Central virtual network.",
    "version": "1.0.0"
  },
  "host": "func-api-dlvcvlrmt2ymi.azurewebsites.net",
  "basePath": "/api",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json",
    "text/plain"
  ],
  "paths": {
    "/httpget": {
      "get": {
        "summary": "Say hello",
        "description": "Returns a greeting for the given name.",
        "operationId": "HttpGet",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Name to greet."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "string"
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/httppost": {
      "post": {
        "summary": "Greet a person",
        "description": "Returns a greeting for the given person's name and age.",
        "operationId": "HttpPostBody",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Person"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "string"
            }
          },
          "400": {
            "description": "Missing name or age"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    }
  },
  "definitions": {
    "Person": {
      "type": "object",
      "required": [
        "name",
        "age"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Person's name"
        },
        "age": {
          "type": "integer",
          "description": "Person's age"
        }
      }
    }
  },
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "name": "code",
      "in": "query"
    }
  }
}
